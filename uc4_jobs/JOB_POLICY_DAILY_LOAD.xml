<?xml version="1.0" encoding="UTF-8"?>
<!-- ============================================================
     UC4 / Automic Job Export
     Job Name    : JOB_POLICY_DAILY_LOAD
     Description : Triggers load_policy_daily.ksh
                   Second job in daily chain.
     Predecessor : JOB_CUST_DAILY_LOAD (must succeed first)
     Successor   : JOB_SETTLEMENT_DAILY_LOAD (on EXIT_CODE=0)
     Trigger     : Triggered by JOB_CUST_DAILY_LOAD success
     Complexity  : MEDIUM
     ============================================================ -->
<uc4export version="12.3.0" exported="2024-01-15T06:00:00Z">

  <jobp name="JOB_POLICY_DAILY_LOAD" type="JOBS">
    <header>
      <title>Policy Daily Staging and SCD2 Dimension Load</title>
      <description>Loads policy feed into POLICY_RAW_STG and calls pkg_policy_hist for SCD Type 2 updates to POLICY_DIM.</description>
      <owner>DW_TEAM</owner>
      <client>100</client>
      <created>2022-03-10</created>
      <modified>2024-01-10</modified>
    </header>

    <trigger>
      <type>EVENT</type>
      <event_source>JOB_CUST_DAILY_LOAD</event_source>
      <event_condition>EXIT_CODE = 0</event_condition>
      <enabled>TRUE</enabled>
    </trigger>

    <runtime>
      <agent>AGENT_DW_PROD_01</agent>
      <login>DW_ORACLE_LOGIN</login>
      <script_type>KSH</script_type>
      <script_path>/opt/datawarehouse/shell_scripts/load_policy_daily.ksh</script_path>
      <script_params>&amp;UC4_DATE_YYYYMMDD &amp;SOURCE_SYSTEM ALL PROD</script_params>
    </runtime>

    <variables>
      <variable name="UC4_DATE_YYYYMMDD" value="&amp;SYSDATE(YYYY-MM-DD)" type="dynamic"/>
      <variable name="SOURCE_SYSTEM"     value="CORE_BANKING"             type="static"/>
      <variable name="PRODUCT_CODE"      value="ALL"                      type="static"/>
      <variable name="ENV"               value="PROD"                     type="static"/>
    </variables>

    <predecessors>
      <predecessor>
        <job_name>JOB_CUST_DAILY_LOAD</job_name>
        <required_exit_code>0</required_exit_code>
        <dependency_type>HARD</dependency_type>
        <!-- Hard dependency: Customer dim must be loaded before Policy -->
      </predecessor>
    </predecessors>

    <successors>
      <successor>
        <job_name>JOB_SETTLEMENT_DAILY_LOAD</job_name>
        <condition>EXIT_CODE = 0</condition>
        <trigger_type>ON_SUCCESS</trigger_type>
      </successor>
    </successors>

    <error_handling>
      <on_failure>
        <action>SEND_NOTIFICATION</action>
        <notification_group>DW_OPS_ALERTS</notification_group>
        <retry_count>1</retry_count>
        <retry_wait_minutes>30</retry_wait_minutes>
        <abort_workflow>TRUE</abort_workflow>
        <!-- Abort chain: Settlement cannot run without Policy dim -->
      </on_failure>
    </error_handling>

  </jobp>

</uc4export>
